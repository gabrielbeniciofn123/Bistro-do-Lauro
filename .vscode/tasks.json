{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar PDV (PHP)",
            "type": "shell",
            "command": "php",
            "args": [
                "-S",
                "127.0.0.1:8080",
                "-t",
                "${workspaceFolder}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "php",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Development Server.*started.*"
                }
            },
            "presentation": {
                "panel": "dedicated",
                "reveal": "always"
            }
        }
    ]
}
